# Copy to .env and fill in real values.
# This file is safe to commit. .env is NOT.

# ── Database ───────────────────────────────────────────────────────────────────
# Service name "db" resolves inside Docker; port 5432 is internal only
POSTGRES_USER=ridder
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=ridder
DATABASE_URL=postgresql://ridder:CHANGE_ME_STRONG_PASSWORD@db:5432/ridder?schema=public

# ── Auth.js ────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
# Необязательно. Если пусто, QR выдачи подписывается AUTH_SECRET.
SCAN_TOKEN_SECRET=
AUTH_URL=https://YOUR_DOMAIN
AUTH_EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
AUTH_EMAIL_FROM=Ridder <noreply@YOUR_DOMAIN>
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# Redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
# Оба значения обязательны. Пустая строка тоже попадает в контейнер и даёт Google 400: missing client_id.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Блокировка входа по паролю. IP и email считаются отдельно.
# 5 неудач за 15 минут, затем пауза 15 минут. Успешный вход сбрасывает только email.
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
# Необязательные отдельные пороги. Пусто — берётся LOGIN_FAILURE_LIMIT.
LOGIN_IP_FAILURE_LIMIT=
LOGIN_EMAIL_FAILURE_LIMIT=
# CSP сначала только сообщает о нарушениях. true — начинает блокировать.
# Включать после проверки консоли браузера на test.peloton-ridder.kz.
CSP_ENFORCE=false

# ── MinIO ──────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=ridder
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD
# S3 connection for the app container (internal Docker network)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=ridder
S3_SECRET_KEY=CHANGE_ME_STRONG_MINIO_PASSWORD
S3_BUCKET=ridder
# Public URL served by nginx (/uploads/ proxied to MinIO bucket)
UPLOAD_URL=https://YOUR_DOMAIN/uploads

# ── App ────────────────────────────────────────────────────────────────────────
APP_URL=https://YOUR_DOMAIN

# ── SMTP (transactional email) ─────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=Ridder <noreply@YOUR_DOMAIN>
ORGANIZER_EMAIL=organizer@YOUR_DOMAIN

# ── ApiPay (Kaspi) ─────────────────────────────────────────────────────────────
# Ключ из кабинета apipay.kz → Настройки → Подключение
APIPAY_API_KEY=
APIPAY_BASE_URL=https://api.apipay.kz/api/v1
# Webhook URL в кабинете ApiPay, без слэша в конце и только https:
# https://YOUR_DOMAIN/api/apipay/webhook
# Секрет того же API-ключа. Пустой секрет отклоняет все уведомления.
APIPAY_WEBHOOK_SECRET=
# Песочница: true только на тестовом сервере вместе с ALLOW_TEST_PAYMENTS=true.
# В production оба значения должны оставаться false. Симуляция оплаты иначе запрещена.
APIPAY_SANDBOX=false
ALLOW_TEST_PAYMENTS=false

# ── Cloudflare Turnstile ───────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── MapTiler ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPTILER_KEY=

# ── Telegram notifications ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
VOLUNTEER_TG_CHAT_ID=
