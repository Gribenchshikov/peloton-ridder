generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String                  @id @default(cuid())
  email                    String                  @unique
  emailVerified            DateTime?
  phone                    String?
  city                     String?
  isAdmin                  Boolean                 @default(false)
  isVolunteer              Boolean                 @default(false)
  createdAt                DateTime                @default(now())
  bannedUntil              DateTime?
  passwordHash             String?
  firstName                String
  lastName                 String
  passwordChangedAt        DateTime?
  totpEnabledAt            DateTime?
  totpSecret               String?
  volunteerRewardClaimedAt DateTime?
  tshirtSize               String?
  birthDate                DateTime?
  avatarUrl                String?
  isFrozen                 Boolean                 @default(false)
  volunteerPromoCode       String?
  runningClubId            String?
  isFinAdmin               Boolean                 @default(false)
  isOperator               Boolean                 @default(false)
  country                  String?
  stravaAccessToken        String?
  stravaAthleteId          String?
  stravaAthleteName        String?
  stravaRefreshToken       String?
  stravaTokenExpiresAt     DateTime?
  clubRequests             ClubMembershipRequest[]
  notificationsSent        Notification[]
  registrations            Registration[]
  runningClub              RunningClub?            @relation("UserClub", fields: [runningClubId], references: [id])
  reviewedApplications     VolunteerApplication[]  @relation("Reviewer")
  volunteerApplications    VolunteerApplication[]  @relation("Applicant")
  waitlistEntries          Waitlist[]
}

model VerificationToken {
  id        String       @id @default(cuid())
  email     String
  token     String       @unique
  expiresAt DateTime
  createdAt DateTime     @default(now())
  purpose   TokenPurpose @default(EMAIL_VERIFY)
}

model VolunteerApplication {
  id           String          @id @default(cuid())
  userId       String
  status       VolunteerStatus @default(PENDING)
  motivation   String
  availability String
  createdAt    DateTime        @default(now())
  reviewedById String?
  reviewedAt   DateTime?
  eventId      String
  experience   String
  stravaUrl    String?
  creditedAt   DateTime?
  event        Event           @relation(fields: [eventId], references: [id])
  reviewedBy   User?           @relation("Reviewer", fields: [reviewedById], references: [id])
  user         User            @relation("Applicant", fields: [userId], references: [id])
}

model Series {
  id          String       @id @default(cuid())
  name        String
  description String?
  seriesRaces SeriesRace[]
}

model Race {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  courseIntro String
  equipment   Json
  landmarks   Json
  icon        String
  color       String
  isChallenge Boolean      @default(false)
  isMass      Boolean      @default(false)
  events      Event[]
  seriesRaces SeriesRace[]
}

model SeriesRace {
  id         String @id @default(cuid())
  seriesId   String
  raceId     String
  stageOrder Int
  race       Race   @relation(fields: [raceId], references: [id])
  series     Series @relation(fields: [seriesId], references: [id])

  @@unique([seriesId, raceId])
}

model Event {
  id                          String                 @id @default(cuid())
  raceId                      String
  year                        Int
  dateISO                     DateTime
  status                      EventStatus            @default(DRAFT)
  location                    String
  transferPrice               Int?
  registrationDeadline        DateTime
  cancellationDeadline        DateTime
  medicalCancellationDeadline DateTime
  resultsUrl                  String?
  itraResultsUrl              String?
  createdAt                   DateTime               @default(now())
  coverImageUrl               String?
  volunteerChatUrl            String?
  regulationBlocks            Json?
  regulationFiles             Json?
  aboutText                   String?
  dayProgram                  Json?
  distanceEquipment           Json?
  howToGet                    String?
  photoLinks                  Json?
  isFeatured                  Boolean                @default(false)
  waiverFiles                 Json?
  isPublished                 Boolean                @default(false)
  volunteerTgTopicId          Int?
  locationUrl                 String?
  eventPhotos                 Json?
  howToGetUrl                 String?
  challengeWindowEnd          DateTime?
  distances                   Distance[]
  race                        Race                   @relation(fields: [raceId], references: [id])
  eventPartners               EventPartner[]
  merchItems                  MerchItem[]
  notifications               Notification[]
  promoCodes                  PromoCode[]
  registrations               Registration[]
  results                     Result[]
  volunteerApplications       VolunteerApplication[]
  waitlist                    Waitlist[]

  @@unique([raceId, year])
}

model Distance {
  id                    String         @id @default(cuid())
  eventId               String
  discipline            String?
  name                  String
  km                    Float
  gain                  Int?
  price                 Int
  minAge                Int?
  maxAge                Int?
  cutoffMinutes         Int?
  profileData           Json?
  bibRangeStart         Int?
  bibRangeEnd           Int?
  createdAt             DateTime       @default(now())
  maxSlots              Int?
  qualificationNote     String?
  requiresInsurance     Boolean        @default(false)
  requiresQualification Boolean        @default(false)
  gpxUrl                String?
  aidStations           Json?
  raceStartMinutes      Int?
  participantRules      Json?
  participantsPerSlot   Int            @default(1)
  certification         String?
  certificationPoints   Int?
  event                 Event          @relation(fields: [eventId], references: [id])
  registrations         Registration[]
  results               Result[]
  waitlist              Waitlist[]
}

model MerchItem {
  id                String              @id @default(cuid())
  eventId           String
  name              String
  requiresSize      Boolean             @default(false)
  order             Int                 @default(0)
  createdAt         DateTime            @default(now())
  event             Event               @relation(fields: [eventId], references: [id])
  registrationMerch RegistrationMerch[]
}

model RegistrationMerch {
  id             String       @id @default(cuid())
  registrationId String
  merchItemId    String
  size           String?
  merchItem      MerchItem    @relation(fields: [merchItemId], references: [id])
  registration   Registration @relation(fields: [registrationId], references: [id])

  @@unique([registrationId, merchItemId])
}

model Registration {
  id                     String              @id @default(cuid())
  userId                 String
  eventId                String
  distanceId             String?
  status                 RegistrationStatus  @default(RESERVED)
  bibNumber              Int?
  reservedUntil          DateTime?
  disqualified           Boolean             @default(false)
  kaspiOrderId           String?
  kaspiPaymentUrl        String?
  createdAt              DateTime            @default(now())
  adminComment           String?
  allowReregistration    Boolean             @default(false)
  runningClubId          String?
  discountAmount         Int                 @default(0)
  promoCodeId            String?
  cancelComment          String?
  cancelReason           CancelReason?
  transferUsedAt         DateTime?
  kitPickedUpAt          DateTime?
  includesTransfer       Boolean             @default(false)
  isTransferOnly         Boolean             @default(false)
  reregistrationCount    Int                 @default(0)
  additionalParticipants Json?
  qualificationUrl       String?
  emergencyContact       String?
  emergencyContactName   String?
  challengeActivities    ChallengeActivity[]
  refundRequests         RefundRequest[]
  distance               Distance?           @relation(fields: [distanceId], references: [id])
  event                  Event               @relation(fields: [eventId], references: [id])
  promoCode              PromoCode?          @relation(fields: [promoCodeId], references: [id])
  runningClub            RunningClub?        @relation(fields: [runningClubId], references: [id])
  user                   User                @relation(fields: [userId], references: [id])
  registrationMerch      RegistrationMerch[]
  result                 Result?

  @@index([eventId])
  @@index([distanceId])
}

model Waitlist {
  id          String   @id @default(cuid())
  userId      String
  eventId     String
  distanceId  String
  contactNote String
  createdAt   DateTime @default(now())
  distance    Distance @relation(fields: [distanceId], references: [id])
  event       Event    @relation(fields: [eventId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@index([eventId])
}

model RefundRequest {
  id             String       @id @default(cuid())
  registrationId String
  type           RefundType
  status         RefundStatus @default(PENDING)
  reason         String?
  adminNote      String?
  requestedAt    DateTime     @default(now())
  resolvedAt     DateTime?
  registration   Registration @relation(fields: [registrationId], references: [id])
}

model Result {
  id             String        @id @default(cuid())
  eventId        String
  bibNumber      Int
  name           String
  place          Int?
  time           String?
  category       String?
  source         ResultSource
  registrationId String?       @unique
  importedAt     DateTime      @default(now())
  distanceId     String?
  distance       Distance?     @relation(fields: [distanceId], references: [id])
  event          Event         @relation(fields: [eventId], references: [id])
  registration   Registration? @relation(fields: [registrationId], references: [id])

  @@index([eventId])
  @@index([distanceId])
}

model Partner {
  id            String         @id @default(cuid())
  name          String
  logoUrl       String
  websiteUrl    String?
  eventPartners EventPartner[]
}

model EventPartner {
  id        String  @id @default(cuid())
  eventId   String
  partnerId String
  event     Event   @relation(fields: [eventId], references: [id])
  partner   Partner @relation(fields: [partnerId], references: [id])

  @@unique([eventId, partnerId])
}

model TeamMember {
  id       String     @id @default(cuid())
  name     String
  role     String
  order    Int
  bio      String?
  photoUrl String?
  type     MemberType @default(TEAM)
}

model TrainingGroup {
  id          String @id @default(cuid())
  title       String
  schedule    String
  description String
  order       Int
}

model Notification {
  id       String   @id @default(cuid())
  eventId  String
  subject  String
  body     String
  sentAt   DateTime @default(now())
  sentById String
  event    Event    @relation(fields: [eventId], references: [id])
  sentBy   User     @relation(fields: [sentById], references: [id])
}

model PromoCode {
  id            String         @id @default(cuid())
  code          String         @unique
  discountType  DiscountType
  discountValue Int
  maxUses       Int?
  usedCount     Int            @default(0)
  expiresAt     DateTime?
  eventId       String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  event         Event?         @relation(fields: [eventId], references: [id])
  registrations Registration[]
}

model RunningClub {
  id                 String                  @id @default(cuid())
  name               String
  city               String?
  createdAt          DateTime                @default(now())
  membershipRequests ClubMembershipRequest[]
  registrations      Registration[]
  memberUsers        User[]                  @relation("UserClub")
}

model ClubMembershipRequest {
  id            String               @id @default(cuid())
  userId        String
  clubName      String
  status        ClubMembershipStatus @default(PENDING)
  runningClubId String?
  adminNote     String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  runningClub   RunningClub?         @relation(fields: [runningClubId], references: [id])
  user          User                 @relation(fields: [userId], references: [id])
}

model ChallengeActivity {
  id               String       @id @default(cuid())
  registrationId   String
  stravaActivityId String       @unique
  distanceKm       Float
  movingTimeSec    Int
  elapsedTimeSec   Int
  avgPaceSecPerKm  Float
  hasGps           Boolean      @default(true)
  startedAt        DateTime
  isValid          Boolean      @default(true)
  invalidReason    String?
  fetchedAt        DateTime     @default(now())
  registration     Registration @relation(fields: [registrationId], references: [id])

  @@index([registrationId])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum DiscountType {
  PERCENT
  FIXED
}

enum VolunteerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  DRAFT
  OPEN
  CLOSED
  COMPLETED
}

enum RegistrationStatus {
  RESERVED
  PAID
  CANCELLED
}

enum ResultSource {
  MYRACE
  EXCEL
  ITRA
}

enum ClubMembershipStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RefundType {
  SLOT
  TRANSFER
}

enum RefundStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum CancelReason {
  INJURY
  CANT_ATTEND
  FINANCIAL
  FAMILY
  CONFLICT
  NOT_READY
  DEFER
  OTHER
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum MemberType {
  TEAM
  VOLUNTEER
}
